<?if $(var.WireRoutePlatform) = "amd64"?>
    <?define UpgradeCode = "0c6bb3df-2e64-437e-ba08-4feec1fa8d12"?>
    <?define ShortcutComponentGuid = "e19abc8d-f805-4e67-a5de-09a8cf3b4de2"?>
<?elseif $(var.WireRoutePlatform) = "arm64"?>
    <?define UpgradeCode = "b2ec1ba4-7ca8-40c1-be45-e16a428c2462"?>
    <?define ShortcutComponentGuid = "f2ce2bbd-b2a2-411d-bc7e-66388962e921"?>
<?else?>
    <?error Unsupported WireRoute platform ?>
<?endif?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product
        Id="*"
        Name="WireRoute"
        Language="1033"
        Version="$(var.WireRouteVersion)"
        Manufacturer="WireRoute contributors"
        UpgradeCode="$(var.UpgradeCode)">
        <Package
            InstallerVersion="500"
            Compressed="yes"
            InstallScope="perMachine"
            Description="WireRoute native WireGuard and RouterOS client"
            ReadOnly="yes" />

        <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
        <MajorUpgrade
            AllowDowngrades="no"
            AllowSameVersionUpgrades="yes"
            DowngradeErrorMessage="A newer version of [ProductName] is already installed."
            Schedule="afterInstallInitialize" />

        <Icon Id="WireRouteIcon" SourceFile="$(var.WireRouteIconPath)" />
        <Property Id="ARPPRODUCTICON" Value="WireRouteIcon" />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/metalcated/wireroute-windows" />
        <Property Id="ARPNOMODIFY" Value="yes" />
        <Property Id="DISABLEADVTSHORTCUTS" Value="yes" />
        <Property Id="MSIRMSHUTDOWN" Value="1" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="WireRouteFolder" Name="WireRoute" />
            </Directory>
            <Directory Id="ProgramMenuFolder" />
        </Directory>

        <DirectoryRef Id="WireRouteFolder">
            <Component Id="WireRouteStartMenuComponent" Guid="$(var.ShortcutComponentGuid)">
                <Shortcut
                    Id="WireRouteStartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="WireRoute"
                    Description="WireRoute native WireGuard and RouterOS client"
                    Target="[WireRouteFolder]WireRoute.exe"
                    WorkingDirectory="WireRouteFolder"
                    Icon="WireRouteIcon" />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\WireRoute"
                    Name="Installed"
                    Type="integer"
                    Value="1"
                    KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <Feature Id="WireRouteFeature" Title="WireRoute" Level="1" Absent="disallow">
            <ComponentGroupRef Id="WireRouteFiles" />
            <ComponentRef Id="WireRouteStartMenuComponent" />
        </Feature>
    </Product>
</Wix>
