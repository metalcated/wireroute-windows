<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="NordicCanvasColor">#111B2A</Color>
    <Color x:Key="NordicSidebarColor">#101A28</Color>
    <Color x:Key="NordicInsetColor">#142235</Color>
    <Color x:Key="NordicSurfaceColor">#182638</Color>
    <Color x:Key="NordicRaisedColor">#213248</Color>
    <Color x:Key="NordicBorderColor">#354A62</Color>
    <Color x:Key="NordicAccentColor">#4C83F3</Color>
    <Color x:Key="NordicPrimaryTextColor">#F3F7FC</Color>
    <Color x:Key="NordicSecondaryTextColor">#A9B8CA</Color>
    <Color x:Key="NordicTertiaryTextColor">#7F92A8</Color>

    <SolidColorBrush x:Key="NordicCanvasBrush" Color="{StaticResource NordicCanvasColor}" />
    <SolidColorBrush x:Key="NordicSidebarBrush" Color="{StaticResource NordicSidebarColor}" />
    <SolidColorBrush x:Key="NordicInsetBrush" Color="{StaticResource NordicInsetColor}" />
    <SolidColorBrush x:Key="NordicSurfaceBrush" Color="{StaticResource NordicSurfaceColor}" />
    <SolidColorBrush x:Key="NordicRaisedBrush" Color="{StaticResource NordicRaisedColor}" />
    <SolidColorBrush x:Key="NordicBorderBrush" Color="{StaticResource NordicBorderColor}" />
    <SolidColorBrush x:Key="NordicAccentBrush" Color="{StaticResource NordicAccentColor}" />
    <SolidColorBrush x:Key="NordicPrimaryTextBrush" Color="{StaticResource NordicPrimaryTextColor}" />
    <SolidColorBrush x:Key="NordicSecondaryTextBrush" Color="{StaticResource NordicSecondaryTextColor}" />
    <SolidColorBrush x:Key="NordicTertiaryTextBrush" Color="{StaticResource NordicTertiaryTextColor}" />

    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="Foreground" Value="{StaticResource NordicPrimaryTextBrush}" />
    </Style>

    <Style x:Key="SidebarActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource NordicPrimaryTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="38" />
    </Style>

    <Style x:Key="NordicCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NordicSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NordicBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="NordicAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NordicAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource NordicPrimaryTextBrush}" />
        <Setter Property="Padding" Value="14,8" />
    </Style>
</ResourceDictionary>
