<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="NordicCanvasColor">#111B2A</Color>
    <Color x:Key="NordicSidebarColor">#101A28</Color>
    <Color x:Key="NordicInsetColor">#142235</Color>
    <Color x:Key="NordicSurfaceColor">#182638</Color>
    <Color x:Key="NordicRaisedColor">#213248</Color>
    <Color x:Key="NordicBorderColor">#354A62</Color>
    <Color x:Key="NordicAccentColor">#4C83F3</Color>
    <Color x:Key="NordicPrimaryTextColor">#F3F7FC</Color>
    <Color x:Key="NordicSecondaryTextColor">#A9B8CA</Color>
    <Color x:Key="NordicTertiaryTextColor">#7F92A8</Color>
    <Color x:Key="WireGuardSyntaxSectionColor">#7EDC75</Color>
    <Color x:Key="WireGuardSyntaxDirectiveColor">#FF5CA8</Color>
    <Color x:Key="WireGuardSyntaxKeyMaterialColor">#F29A55</Color>
    <Color x:Key="WireGuardSyntaxValueColor">#58A6FF</Color>
    <Color x:Key="WireGuardSyntaxNumberColor">#C6A0F6</Color>

    <SolidColorBrush x:Key="NordicCanvasBrush" Color="{StaticResource NordicCanvasColor}" />
    <SolidColorBrush x:Key="NordicSidebarBrush" Color="{StaticResource NordicSidebarColor}" />
    <SolidColorBrush x:Key="NordicInsetBrush" Color="{StaticResource NordicInsetColor}" />
    <SolidColorBrush x:Key="NordicSurfaceBrush" Color="{StaticResource NordicSurfaceColor}" />
    <SolidColorBrush x:Key="NordicRaisedBrush" Color="{StaticResource NordicRaisedColor}" />
    <SolidColorBrush x:Key="NordicBorderBrush" Color="{StaticResource NordicBorderColor}" />
    <SolidColorBrush x:Key="NordicAccentBrush" Color="{StaticResource NordicAccentColor}" />
    <SolidColorBrush x:Key="NordicPrimaryTextBrush" Color="{StaticResource NordicPrimaryTextColor}" />
    <SolidColorBrush x:Key="NordicSecondaryTextBrush" Color="{StaticResource NordicSecondaryTextColor}" />
    <SolidColorBrush x:Key="NordicTertiaryTextBrush" Color="{StaticResource NordicTertiaryTextColor}" />
    <SolidColorBrush x:Key="WireGuardSyntaxSectionBrush" Color="{StaticResource WireGuardSyntaxSectionColor}" />
    <SolidColorBrush x:Key="WireGuardSyntaxDirectiveBrush" Color="{StaticResource WireGuardSyntaxDirectiveColor}" />
    <SolidColorBrush x:Key="WireGuardSyntaxKeyMaterialBrush" Color="{StaticResource WireGuardSyntaxKeyMaterialColor}" />
    <SolidColorBrush x:Key="WireGuardSyntaxValueBrush" Color="{StaticResource WireGuardSyntaxValueColor}" />
    <SolidColorBrush x:Key="WireGuardSyntaxNumberBrush" Color="{StaticResource WireGuardSyntaxNumberColor}" />

    <StaticResource x:Key="ComboBoxBackground" ResourceKey="NordicRaisedBrush" />
    <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="NordicSurfaceBrush" />
    <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="NordicInsetBrush" />
    <StaticResource x:Key="ComboBoxBackgroundUnfocused" ResourceKey="NordicRaisedBrush" />
    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="NordicBorderBrush" />
    <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="NordicAccentBrush" />
    <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="NordicAccentBrush" />
    <StaticResource x:Key="ComboBoxForeground" ResourceKey="NordicPrimaryTextBrush" />
    <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="NordicPrimaryTextBrush" />
    <StaticResource x:Key="ComboBoxForegroundFocusedPressed" ResourceKey="NordicPrimaryTextBrush" />
    <StaticResource x:Key="ComboBoxPlaceHolderForeground" ResourceKey="NordicSecondaryTextBrush" />
    <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="NordicSurfaceBrush" />
    <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="NordicBorderBrush" />
    <StaticResource x:Key="ComboBoxDropDownForeground" ResourceKey="NordicPrimaryTextBrush" />
    <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="NordicSecondaryTextBrush" />
    <StaticResource x:Key="ComboBoxItemBackground" ResourceKey="NordicSurfaceBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="NordicRaisedBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="NordicInsetBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="NordicAccentBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedUnfocused" ResourceKey="NordicAccentBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="NordicAccentBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="NordicAccentBrush" />
    <StaticResource x:Key="ComboBoxItemBorderBrush" ResourceKey="NordicSurfaceBrush" />
    <StaticResource x:Key="ComboBoxItemBorderBrushPointerOver" ResourceKey="NordicRaisedBrush" />
    <StaticResource x:Key="ComboBoxItemBorderBrushPressed" ResourceKey="NordicInsetBrush" />
    <StaticResource x:Key="ComboBoxItemBorderBrushSelected" ResourceKey="NordicAccentBrush" />
    <StaticResource x:Key="ComboBoxItemBorderBrushSelectedUnfocused" ResourceKey="NordicAccentBrush" />
    <StaticResource x:Key="ComboBoxItemBorderBrushSelectedPressed" ResourceKey="NordicAccentBrush" />
    <StaticResource x:Key="ComboBoxItemBorderBrushSelectedPointerOver" ResourceKey="NordicAccentBrush" />
    <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="NordicPrimaryTextBrush" />
    <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="NordicPrimaryTextBrush" />
    <StaticResource x:Key="ComboBoxItemForegroundPressed" ResourceKey="NordicPrimaryTextBrush" />
    <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="NordicPrimaryTextBrush" />
    <StaticResource x:Key="ComboBoxItemForegroundSelectedUnfocused" ResourceKey="NordicPrimaryTextBrush" />
    <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="NordicPrimaryTextBrush" />
    <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="NordicPrimaryTextBrush" />

    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="Foreground" Value="{StaticResource NordicPrimaryTextBrush}" />
    </Style>

    <Style x:Key="SidebarActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource NordicPrimaryTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="38" />
    </Style>

    <Style x:Key="NordicCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NordicSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NordicBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="NordicAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NordicAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource NordicPrimaryTextBrush}" />
        <Setter Property="Padding" Value="14,8" />
    </Style>
</ResourceDictionary>
