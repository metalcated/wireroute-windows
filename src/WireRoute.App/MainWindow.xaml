<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WireRoute.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WireRoute.App.Models"
    Title="WireRoute">

    <Grid x:Name="Root" Background="{StaticResource NordicCanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{StaticResource NordicSidebarBrush}" />

        <Grid x:Name="TitleBarDragRegion" Grid.ColumnSpan="2" Height="48">
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="17"
                    Foreground="{StaticResource NordicAccentBrush}"
                    Glyph="&#xE83B;" />
                <TextBlock FontFamily="Segoe UI Variable Display" FontSize="16" FontWeight="SemiBold" Text="WireRoute" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="12,10,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="8,4,8,10" Spacing="3">
                <TextBlock FontFamily="Segoe UI Variable Display" FontSize="20" FontWeight="SemiBold" Text="Profiles" />
                <TextBlock
                    Foreground="{StaticResource NordicSecondaryTextBrush}"
                    FontSize="12"
                    Text="Choose a profile to connect or change its routing."
                    TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Margin="10,8,10,6"
                Foreground="{StaticResource NordicTertiaryTextBrush}"
                FontSize="11"
                FontWeight="SemiBold"
                Text="PROFILES" />

            <Grid Grid.Row="2">
                <ListView
                    x:Name="ProfilesList"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{x:Bind Profiles}"
                    SelectionChanged="ProfilesList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ProfileNavigationItem">
                            <Grid Padding="10,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource NordicTertiaryTextBrush}" />
                                <StackPanel Grid.Column="1" Margin="10,0,8,0" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{StaticResource NordicSecondaryTextBrush}"
                                        FontSize="11"
                                        Text="{x:Bind Status}" />
                                </StackPanel>
                                <Border
                                    Grid.Column="2"
                                    Padding="7,3"
                                    Background="{StaticResource NordicInsetBrush}"
                                    CornerRadius="5">
                                    <TextBlock
                                        Foreground="{StaticResource NordicSecondaryTextBrush}"
                                        FontSize="10"
                                        Text="{x:Bind RoutingLabel}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="ProfilesEmptyState"
                    Margin="18,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Spacing="5">
                    <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource NordicSecondaryTextBrush}" Text="No profiles yet" />
                    <TextBlock
                        MaxWidth="210"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource NordicTertiaryTextBrush}"
                        FontSize="11"
                        Text="Import a WireGuard configuration to inspect its routing and DNS before connecting it to the manager."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <TextBlock
                Grid.Row="3"
                Margin="10,12,10,6"
                Foreground="{StaticResource NordicTertiaryTextBrush}"
                FontSize="11"
                FontWeight="SemiBold"
                Text="MANAGE" />

            <StackPanel Grid.Row="4" Spacing="3">
                <Button x:Name="RouterOSButton" Click="RouterOSButton_Click" Style="{StaticResource SidebarActionButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="RouterOSRail" Width="3" Height="20" Background="{StaticResource NordicAccentBrush}" CornerRadius="2" Visibility="Collapsed" />
                        <FontIcon Grid.Column="1" FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE950;" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="Normal" Text="RouterOS Peers" />
                        <FontIcon Grid.Column="3" FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE76C;" />
                    </Grid>
                </Button>
                <Button x:Name="SettingsButton" Click="SettingsButton_Click" Style="{StaticResource SidebarActionButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="SettingsRail" Width="3" Height="20" Background="{StaticResource NordicAccentBrush}" CornerRadius="2" Visibility="Collapsed" />
                        <FontIcon Grid.Column="1" FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE713;" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="Normal" Text="Settings" />
                        <FontIcon Grid.Column="3" FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE76C;" />
                    </Grid>
                </Button>
            </StackPanel>

            <Grid Grid.Row="5" Margin="0,12,0,0" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ImportProfileButton"
                    Style="{StaticResource SidebarActionButtonStyle}"
                    ToolTipService.ToolTip="Add or import a WireGuard profile.">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Grid.Column="1" Margin="8,0" Text="Add profile" />
                        <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE70D;" />
                    </Grid>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="AddEmptyProfileMenuItem_Click" Icon="Add" Text="Add Empty Tunnel…" />
                            <MenuFlyoutItem Click="ImportProfileMenuItem_Click" Text="Import Tunnel(s) from File…" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource SidebarActionButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE712;" />
                        <TextBlock Grid.Column="1" Margin="8,0" Text="More" />
                        <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE70D;" />
                    </Grid>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="ViewLogMenuItem_Click" Text="View Log…" />
                            <MenuFlyoutItem Click="ExportAllProfilesMenuItem_Click" Text="Export Tunnels to Zip…" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="DeleteSelectedProfileMenuItem_Click" Text="Delete Selected" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Padding="36,28,36,36">
            <Grid x:Name="ProfileEmptyPanel">
                <StackPanel MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                    <Border
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Background="{StaticResource NordicSurfaceBrush}"
                        BorderBrush="{StaticResource NordicBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="26"
                            Foreground="{StaticResource NordicAccentBrush}"
                            Glyph="&#xE83B;" />
                    </Border>
                    <StackPanel Spacing="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Text="Choose a profile" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource NordicSecondaryTextBrush}"
                            Text="Select a WireGuard profile to view its connection, routing, DNS, and activity."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Style="{StaticResource NordicCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="15" Text="No profiles are available" />
                            <TextBlock
                                Foreground="{StaticResource NordicSecondaryTextBrush}"
                                FontSize="12"
                                Text="Import a .conf file to review it locally. Saving and tunnel activation remain isolated until the manager protocol is connected."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="ProfileDetailPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="900" HorizontalAlignment="Center" Spacing="16">
                    <Border Style="{StaticResource NordicCardStyle}" Padding="22">
                        <StackPanel Spacing="18">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" BorderBrush="{StaticResource NordicAccentBrush}" BorderThickness="3" CornerRadius="24">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource NordicAccentBrush}" FontSize="22" Glyph="&#xE909;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ProfileNameText" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="Bold" />
                                    <TextBlock x:Name="ProfileStorageStatusText" Foreground="{StaticResource NordicSecondaryTextBrush}" FontSize="13" />
                                </StackPanel>
                                <Button x:Name="ProfileConnectButton" Grid.Column="2" MinWidth="126" Click="ProfileConnectButton_Click" Content="Activate" Style="{StaticResource NordicAccentButtonStyle}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE768;" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                <Button Grid.Column="3" Click="ProfileEditButton_Click" Content="Edit" />
                            </Grid>

                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="330" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="7">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="Traffic routing" />
                                    <TextBlock x:Name="ProfileRoutingHelpText" Foreground="{StaticResource NordicSecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid Grid.Column="1" Height="36" Background="{StaticResource NordicRaisedBrush}" CornerRadius="6" ColumnSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ProfileSplitButton" HorizontalAlignment="Stretch" Click="ProfileSplitButton_Click" Content="Split" />
                                    <Button x:Name="ProfileFullButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="ProfileFullButton_Click" Content="Full" />
                                </Grid>
                            </Grid>

                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="DNS Protection" />
                                    <TextBlock x:Name="ProfileDnsHelpText" Foreground="{StaticResource NordicSecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="ProfileDnsProtectionButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xEA18;" />
                                        <TextBlock x:Name="ProfileDnsModeText" Text="Profile DNS" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="HooksWarningBorder" Background="{StaticResource NordicRaisedBrush}" BorderBrush="{StaticResource NordicAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Foreground="{StaticResource NordicAccentBrush}" Glyph="&#xE7BA;" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Configuration hooks require review" />
                                <TextBlock Foreground="{StaticResource NordicSecondaryTextBrush}" FontSize="12" Text="PreUp, PostUp, PreDown, and PostDown commands are blocked from service-free activation until removed." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource NordicCardStyle}" Padding="18">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock FontFamily="Segoe UI Variable Display" FontSize="17" FontWeight="SemiBold" Text="Activity" />
                                <Button HorizontalAlignment="Right" Click="ProfileHistoryButton_Click" Content="History…" />
                            </Grid>
                            <Grid ColumnSpacing="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Foreground="{StaticResource NordicAccentBrush}" FontSize="11" FontWeight="SemiBold" Text="Download" />
                                    <TextBlock x:Name="ProfileDownloadText" FontSize="15" FontWeight="SemiBold" Text="Zero KB/s" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Foreground="#19D3D1" FontSize="11" FontWeight="SemiBold" Text="Upload" />
                                    <TextBlock x:Name="ProfileUploadText" FontSize="15" FontWeight="SemiBold" Text="Zero KB/s" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Foreground="{StaticResource NordicSecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" Text="Session total" />
                                    <TextBlock x:Name="ProfileSessionTotalText" FontSize="15" FontWeight="SemiBold" Text="—" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="3">
                                    <TextBlock Foreground="{StaticResource NordicSecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" Text="Last handshake" />
                                    <TextBlock x:Name="ProfileHandshakeText" FontSize="15" FontWeight="SemiBold" Text="—" />
                                </StackPanel>
                            </Grid>
                            <Grid Height="82">
                                <Rectangle Height="1" VerticalAlignment="Top" Fill="{StaticResource NordicBorderBrush}" />
                                <Rectangle Height="1" VerticalAlignment="Center" Fill="{StaticResource NordicBorderBrush}" />
                                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource NordicBorderBrush}" />
                                <TextBlock x:Name="ProfileActivityText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource NordicSecondaryTextBrush}" FontSize="12" Text="Connect this profile to begin recording traffic." />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="18">
                                <TextBlock Foreground="{StaticResource NordicSecondaryTextBrush}" FontSize="11" Text="● Download" />
                                <TextBlock Foreground="{StaticResource NordicSecondaryTextBrush}" FontSize="11" Text="● Upload" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="4,4,0,-8" Foreground="{StaticResource NordicSecondaryTextBrush}" FontSize="14" FontWeight="SemiBold" Text="Configuration details" />
                    <Border Style="{StaticResource NordicCardStyle}" Padding="24">
                        <Grid RowSpacing="10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="Interface:" />
                            <TextBlock Grid.Column="1" x:Name="ProfileInterfaceNameText" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="Public key:" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProfilePublicKeyText" FontFamily="Cascadia Mono" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" HorizontalAlignment="Right" FontWeight="SemiBold" Text="Addresses:" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ProfileAddressesText" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" HorizontalAlignment="Right" FontWeight="SemiBold" Text="DNS servers:" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ProfileDnsServersText" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" HorizontalAlignment="Right" FontWeight="SemiBold" Text="Peer:" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ProfilePeerPublicKeyText" FontFamily="Cascadia Mono" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="5" HorizontalAlignment="Right" FontWeight="SemiBold" Text="Endpoint:" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ProfileEndpointText" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="6" HorizontalAlignment="Right" FontWeight="SemiBold" Text="Allowed IPs:" />
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="ProfileRoutesText" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="7" HorizontalAlignment="Right" FontWeight="SemiBold" Text="Persistent keepalive:" />
                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="ProfileKeepaliveText" />
                            <TextBlock Grid.Row="8" HorizontalAlignment="Right" FontWeight="SemiBold" Text="On-Demand:" />
                            <TextBlock Grid.Row="8" Grid.Column="1" x:Name="ProfileOnDemandText" Text="Off" />
                            <TextBlock Grid.Row="9" HorizontalAlignment="Right" FontWeight="SemiBold" Text="Search domains:" />
                            <TextBlock Grid.Row="9" Grid.Column="1" x:Name="ProfileDnsSearchText" TextWrapping="Wrap" />
                            <TextBlock x:Name="ProfilePeersText" Visibility="Collapsed" />
                            <TextBlock x:Name="ProfileRoutingModeText" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="RouterOSPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="920" HorizontalAlignment="Center" Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" Text="RouterOS Peer Manager" />
                            <TextBlock
                                Foreground="{StaticResource NordicSecondaryTextBrush}"
                                Text="Discover WireGuard interfaces and peers before creating a client profile."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Background="#1F4C83F3"
                            CornerRadius="6"
                            Padding="14,5">
                            <TextBlock Foreground="{StaticResource NordicAccentBrush}" FontSize="11" FontWeight="SemiBold" Text="GUARDED" />
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource NordicCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock FontFamily="Segoe UI Variable Display" FontSize="17" FontWeight="SemiBold" Text="RouterOS connection" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="RouterOSConnectionPicker"
                                    MinWidth="320"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{x:Bind RouterOSConnections}"
                                    SelectionChanged="RouterOSConnectionPicker_SelectionChanged" />
                                <Button
                                    x:Name="RouterOSConnectButton"
                                    Grid.Column="1"
                                    Click="RouterOSConnectButton_Click"
                                    Content="Connect"
                                    Style="{StaticResource NordicAccentButtonStyle}" />
                                <ProgressRing
                                    x:Name="RouterOSProgressRing"
                                    Grid.Column="2"
                                    Width="20"
                                    Height="20"
                                    IsActive="False" />
                                <Button
                                    Grid.Column="3"
                                    Click="RouterOSManageConnectionsButton_Click"
                                    Content="Manage in Settings…" />
                            </Grid>
                            <TextBlock
                                Foreground="{StaticResource NordicSecondaryTextBrush}"
                                FontSize="12"
                                Text="Set up and manage connections in Settings. Then choose a router here and Connect."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        x:Name="RouterOSStatusText"
                        Foreground="{StaticResource NordicSecondaryTextBrush}"
                        Text="Discovery is read-only. Every RouterOS change requires a separate review and confirmation."
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RouterOSSummaryText" VerticalAlignment="Center" FontWeight="SemiBold" Text="Not connected" />
                        <CheckBox
                            x:Name="RouterOSShowAllPeersCheckBox"
                            Grid.Column="1"
                            IsEnabled="False"
                            Checked="RouterOSShowAllPeersCheckBox_Changed"
                            Content="Show all peers"
                            ToolTipService.ToolTip="Include site-to-site and manually created peers. WireRoute clients are identified by their RouterOS comment."
                            Unchecked="RouterOSShowAllPeersCheckBox_Changed" />
                        <Button
                            x:Name="RouterOSSetUpPeerButton"
                            Grid.Column="2"
                            Click="RouterOSSetUpPeerButton_Click"
                            IsEnabled="False"
                            Content="Set Up Peer…" />
                    </Grid>

                    <TextBlock
                        x:Name="RouterOSPeerActionHelpText"
                        Margin="0,-8,0,0"
                        Foreground="{StaticResource NordicSecondaryTextBrush}"
                        FontSize="12"
                        Text="Connect to this router to enable peer setup."
                        TextAlignment="Right"
                        TextWrapping="Wrap" />

                    <Border Style="{StaticResource NordicCardStyle}" Padding="0">
                        <Grid MinHeight="260">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Padding="16,10" Background="{StaticResource NordicInsetBrush}" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{StaticResource NordicTertiaryTextBrush}" FontSize="11" FontWeight="SemiBold" Text="NAME" />
                                <TextBlock Grid.Column="1" Foreground="{StaticResource NordicTertiaryTextBrush}" FontSize="11" FontWeight="SemiBold" Text="INTERFACE" />
                                <TextBlock Grid.Column="2" Foreground="{StaticResource NordicTertiaryTextBrush}" FontSize="11" FontWeight="SemiBold" Text="STATUS" />
                            </Grid>
                            <ListView
                                x:Name="RouterOSDiscoveryList"
                                Grid.Row="1"
                                Background="Transparent"
                                BorderThickness="0"
                                IsItemClickEnabled="False"
                                ItemsSource="{x:Bind RouterOSDiscoveryRows}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10,8" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Foreground="{StaticResource NordicSecondaryTextBrush}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Foreground="{StaticResource NordicSecondaryTextBrush}" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="RouterOSDiscoveryEmptyText"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource NordicTertiaryTextBrush}"
                                Text="Connect to securely discover WireGuard peers."
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="820" HorizontalAlignment="Center" Spacing="18">
                    <StackPanel Spacing="5">
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" Text="Settings" />
                        <TextBlock
                            Foreground="{StaticResource NordicSecondaryTextBrush}"
                            Text="Manage how WireRoute looks, stores local activity, and handles diagnostics and support."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Style="{StaticResource NordicCardStyle}">
                        <StackPanel Spacing="16">
                            <TextBlock FontFamily="Segoe UI Variable Display" FontSize="17" FontWeight="SemiBold" Text="Appearance" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Theme" />
                                    <TextBlock Foreground="{StaticResource NordicSecondaryTextBrush}" FontSize="12" Text="Nordic Blue is the default dark navy interface." />
                                </StackPanel>
                                <ComboBox Grid.Column="1" IsEnabled="False" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Nordic Blue" />
                                    <ComboBoxItem Content="System" />
                                </ComboBox>
                            </Grid>
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Windows tray icon" />
                                    <TextBlock Foreground="{StaticResource NordicSecondaryTextBrush}" FontSize="12" Text="Keep WireRoute available from the notification area." />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsEnabled="False" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource NordicCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock FontFamily="Segoe UI Variable Display" FontSize="17" FontWeight="SemiBold" Text="RouterOS Connections" />
                            <TextBlock
                                Foreground="{StaticResource NordicSecondaryTextBrush}"
                                FontSize="12"
                                Text="Saved connections and passwords will use protected Windows credential storage. Read-only interface loading never changes RouterOS."
                                TextWrapping="Wrap" />
                            <Border
                                MinHeight="128"
                                Background="{StaticResource NordicInsetBrush}"
                                BorderBrush="{StaticResource NordicBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <ListView
                                        x:Name="RouterOSConnectionsList"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{x:Bind RouterOSConnections}"
                                        SelectionChanged="RouterOSConnectionsList_SelectionChanged"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="8,6" ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*" />
                                                        <ColumnDefinition Width="1.5*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Foreground="{StaticResource NordicSecondaryTextBrush}" Text="{Binding Url}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Foreground="{StaticResource NordicSecondaryTextBrush}" Text="{Binding DefaultInterface}" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock
                                        x:Name="RouterOSConnectionsEmptyText"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource NordicTertiaryTextBrush}"
                                        Text="No RouterOS connections yet. Add one to use RouterOS Peers."
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="RouterOSAddConnectionButton_Click" Content="Add Connection…" />
                                <Button x:Name="RouterOSEditConnectionButton" Click="RouterOSEditConnectionButton_Click" Content="Edit…" IsEnabled="False" />
                                <Button x:Name="RouterOSRemoveConnectionButton" Click="RouterOSRemoveConnectionButton_Click" Content="Remove…" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource NordicCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock FontFamily="Segoe UI Variable Display" FontSize="17" FontWeight="SemiBold" Text="Data and diagnostics" />
                            <TextBlock Foreground="{StaticResource NordicSecondaryTextBrush}" FontSize="12" Text="Activity stays on this device. Retention, logs, and export are connected in later milestones." TextWrapping="Wrap" />
                            <Button IsEnabled="False" HorizontalAlignment="Left" Content="View logs and diagnostics" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid
            x:Name="ModalOverlay"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Canvas.ZIndex="1000"
            Background="#B3000000"
            KeyDown="ModalOverlay_KeyDown"
            Visibility="Collapsed">
            <Border
                x:Name="ModalFrame"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource NordicCanvasBrush}"
                BorderBrush="{StaticResource NordicBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentPresenter x:Name="ModalHeaderPresenter" Margin="0,0,0,18" />
                    <ScrollViewer
                        x:Name="ModalContentScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Auto">
                        <ContentPresenter x:Name="ModalContentPresenter" />
                    </ScrollViewer>
                    <ContentPresenter x:Name="ModalFooterPresenter" Grid.Row="2" Margin="0,18,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
